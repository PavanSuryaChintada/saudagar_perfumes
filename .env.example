# Copy to .env.local and fill in. Only VITE_* values reach the browser bundle.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Leave unset on demo deployments (search engines kept out). On the real domain: true, plus the site address.
# VITE_ALLOW_INDEXING=true
# VITE_SITE_URL=https://www.saudagarperfumes.com

# Tooling only (scripts/*.mjs) — never prefix with VITE_
SUPABASE_PROJECT_REF=<project-ref>
SUPABASE_ACCESS_TOKEN=sbp_...
SUPABASE_DB_PASSWORD=
